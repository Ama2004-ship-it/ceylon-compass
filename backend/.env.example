PORT=5000

# MySQL (XAMPP defaults shown)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ceylon_compass

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=2h

# Reference location used for distance calculations (Panadura area)
REFERENCE_LAT=6.7296579
REFERENCE_LNG=79.9294361

# Max allowed radius (km) for places / itinerary boundary
MAX_RADIUS_KM=25

# Frontend origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173
